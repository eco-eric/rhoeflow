{
  "name": "@rhoeflow/schema",
  "version": "0.1.0",
  "private": true,
  "description": "RhoeFlow Assessment schema: provenance-carrying fields over an HPXML-shaped building model (ADR-023, 024, 027, 028)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "development": "./src/testing.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
