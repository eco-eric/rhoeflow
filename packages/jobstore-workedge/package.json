{
  "name": "@rhoeflow/jobstore-workedge",
  "version": "0.0.1",
  "private": true,
  "description": "JobStore over the WorkEdge API/MCP. WO-01: documented request/response shapes, every call stubbed; no network (ADR-011, 030, 031)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rhoeflow/jobstore": "workspace:*",
    "@rhoeflow/schema": "workspace:*"
  }
}
