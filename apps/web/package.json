{
  "name": "@rhoeflow/web",
  "version": "0.0.1",
  "private": true,
  "description": "RhoeFlow Pro web app (Next.js on Cloudflare Workers via OpenNext, ADR-036). WO-01: placeholder page only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@rhoeflow/calc": "workspace:*",
    "@rhoeflow/schema": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "wrangler": "4.152.0"
  }
}
