// RhoeFlow web app on Cloudflare Workers via the OpenNext adapter (ADR-036, supersedes the
// hosting half of ADR-013). Supabase stays the app's own data store for now (ADR-013 data half).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhoeflow-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Lets the worker call itself for cache revalidation (OpenNext requirement).
    { "binding": "WORKER_SELF_REFERENCE", "service": "rhoeflow-web" }
  ],
  // The app lives at app.rhoeflow.pro (owner, 2026-10-26, confirmed 2026-11-01). rhoeflow.pro and
  // www.rhoeflow.pro belong to the marketing site, Worker `rhoeflow-site` (repo eco-eric/rhoeflow-site).
  // Never list them here: a deploy of this Worker would take them back from the site.
  "routes": [
    { "pattern": "app.rhoeflow.pro", "custom_domain": true }
  ],
  // Cloudflare Browser Run prints the report PDF through its `pdf` Quick Action (ADR-037, WO-03 E2).
  // Needs compatibility_date 2026-03-24 or later. No API token; Quick Actions do not run in local
  // `wrangler dev` (use `wrangler dev --remote`).
  "browser": { "binding": "BROWSER" },
  // WorkEdge's MCP server, one address for every account (ADR-038). Not a secret; each account's own
  // key is stored encrypted in rhoe.workedge_connections. WorkEdge's web app moved to the
  // gzwmnuxjuvxcwbaykawi project on 2026-11-02; the old vesncoasnajcdinipgkv project no longer gets
  // new jobs, so RhoeFlow reads the new one. The master key RHOE_CONNECTION_KEY is a secret
  // set with `wrangler secret put`, never here.
  "vars": { "WORKEDGE_MCP_URL": "https://gzwmnuxjuvxcwbaykawi.supabase.co/functions/v1/mcp" },
  "observability": { "enabled": true }
}
