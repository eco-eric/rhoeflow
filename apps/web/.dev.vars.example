# Local secrets for `pnpm preview` (wrangler). Copy to .dev.vars (gitignored). Never commit real values.
# Production values are set with `wrangler secret put <NAME>` or in the Cloudflare dashboard.
NEXTJS_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: bucket names (defaults shown). Frozen run bundles and the interim media store (ADR-031).
RHOE_RUNS_BUCKET=rhoe-runs
RHOE_MEDIA_BUCKET=rhoe-media
