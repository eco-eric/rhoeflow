# RhoeFlow environment. Copy to .env (gitignored). Never commit real values.
# The app's OWN Supabase project (Assessments, runs, artifacts, interim media). Never WorkEdge's (ADR-031).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bucket for jobstore-local interim media (ADR-031). Default: rhoe-media
RHOE_MEDIA_BUCKET=rhoe-media
# WorkEdge (ADR-038). The MCP address is one value for every account (wrangler.jsonc vars in
# production). There is no WorkEdge key here: each account pastes its own on Connect WorkEdge, and
# it is stored encrypted with RHOE_CONNECTION_KEY (32 random bytes, base64).
WORKEDGE_MCP_URL=https://gzwmnuxjuvxcwbaykawi.supabase.co/functions/v1/mcp
RHOE_CONNECTION_KEY=
