# RhoeFlow environment. Copy to .env (gitignored). Never commit real values.
# The app's OWN Supabase project (Assessments, runs, artifacts, interim media). Never WorkEdge's (ADR-031).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bucket for jobstore-local interim media (ADR-031). Default: rhoe-media
RHOE_MEDIA_BUCKET=rhoe-media
# WorkEdge API (jobstore-workedge). Unused in WO-01; no live calls are made.
WORKEDGE_API_URL=
WORKEDGE_API_KEY=
